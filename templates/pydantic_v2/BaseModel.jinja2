{% for decorator in decorators -%}
{{ decorator }}
{% endfor -%}
class {{ class_name }}({%- if schema_runtime_validation_use_base -%}{{ schema_runtime_validation_base_class_name }}{% if base_class != 'BaseModel' %}, {{ base_class }}{% endif %}{%- else -%}{{ base_class }}{%- endif -%}):{% if comment is defined %}  # {{ comment }}{% endif %}
{%- if description %}
    {{ description }}
{%- endif %}
{%- if not fields and not description and not config and not class_body_lines and not schema_runtime_validation %}
    pass
{%- endif %}
{%- if config %}
{%- filter indent(4) %}
{% include 'ConfigDict.jinja2' %}
{%- endfilter %}
{%- endif %}
{%- for field in fields %}
{%- if field.use_pydantic_extra_annotations_dict %}
    __annotations__ = {
        '__pydantic_extra__': {{ field.pydantic_extra_type_hint }},
    }
{%- endif %}
{%- endfor %}
{%- for line in class_body_lines %}
    {{ line }}
{%- endfor %}
{%- include 'schema_runtime_validation.jinja2' %}
{%- for field in fields %}
    {%- if not field.use_pydantic_extra_annotations_dict and not field.annotated and field.field %}
    {{ field.name }}: {{ field.type_hint }} = {{ field.field }}
    {%- elif not field.use_pydantic_extra_annotations_dict %}
    {%- if field.annotated %}
    {{ field.name }}: {{ field.annotated }}
    {%- else %}
    {{ field.name }}: {{ field.type_hint }}
    {%- endif %}
    {%- if not field.has_default_factory_in_field and (not field.required or field.use_default_with_required) and (field.represented_default != 'None' or not field.strip_default_none or field.data_type.is_optional)
            %} = {{ field.represented_default }}
    {%- endif -%}
    {%- endif %}
    {%- if field.docstring %}
    {{ field.docstring }}
{%- if field.use_inline_field_description and not loop.last %}

{% endif %}
    {%- elif field.inline_field_docstring %}
    {{ field.inline_field_docstring }}
{%- if not loop.last %}

{% endif %}
    {%- endif %}
{%- endfor -%}
{%- for method in methods %}

    {{ method }}
{%- endfor -%}
{%- if prepared_validators %}
{% for v in prepared_validators %}

    @field_validator({{ v.fields_str }}, {{ v.mode_str }})
    @classmethod
{%- if v.mode == 'wrap' %}
    def {{ v.method_name }}(cls, v: Any, handler: ValidatorFunctionWrapHandler, info: ValidationInfo) -> Any:
        return {{ v.function_name }}(v, handler, info)
{%- elif v.mode == 'plain' %}
    def {{ v.method_name }}(cls, v: Any) -> Any:
        return {{ v.function_name }}(v)
{%- else %}
    def {{ v.method_name }}(cls, v: Any, info: ValidationInfo) -> Any:
        return {{ v.function_name }}(v, info)
{%- endif %}
{%- endfor %}
{%- endif %}
{# Extend the upstream BaseModel template with constructor ergonomics only.
   Fields and constraints above remain schema-derived. #}
{% set geometry_inputs = {
    'Point': 'Sequence[float]',
    'Linestring': 'Sequence[LinestringCoordinate | Sequence[float]]',
    'Polygon': 'Sequence[PolygonCoordinate | Sequence[PolygonCoordinateItem | Sequence[float]]]',
    'Multipoint': 'Sequence[MultipointCoordinate | Sequence[float]]',
    'Multilinestring': 'Sequence[MultilinestringCoordinate | Sequence[MultilinestringCoordinateItem | Sequence[float]]]',
    'Multipolygon': 'Sequence[Sequence[MultipolygonCoordinate | Sequence[MultipolygonCoordinateItem | Sequence[float]]]]',
    'Geometrycollection': 'Sequence[Point | Linestring | Polygon | Multipoint | Multilinestring | Multipolygon]'
} %}
{% if class_name in geometry_inputs %}
{% set argument = 'geometries' if class_name == 'Geometrycollection' else 'coordinates' %}

    def __init__(
        self,
        {{ argument }}: {{ geometry_inputs[class_name] }} | PydanticUndefinedType = PydanticUndefined,
        **data: object,
    ) -> None:
        """Build a geometry from positional or keyword {{ argument }}.

        Args:
            {{ argument }}: Geometry members in GeoJSON order, as lists or tuples.
            **data: Additional GeoJSON fields, validated by the generated model.

        Raises:
            pydantic.ValidationError: If the geometry violates the schema constraints.
        """
        if {{ argument }} is not PydanticUndefined:
            data["{{ argument }}"] = {{ argument }}
        super().__init__(**data)
{% endif %}
